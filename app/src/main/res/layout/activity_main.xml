<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Tieu de -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HO SO HOC TAP"
            android:textColor="#1D4ED8"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quan ly va tra cuu ho so sinh vien"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="THONG TIN SINH VIEN"
                    android:textColor="#1D4ED8"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <!-- Anh dai dien minh hoa -->
                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:background="#DBEAFE"
                    android:gravity="center"
                    android:text="SV"
                    android:textColor="#1D4ED8"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHoTen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nguyen Thi Khanh Vy"
                    android:textColor="#0F172A"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvMssv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MSSV: 2415053122350"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lop: 24T3"
                    android:textColor="#334155"
                    android:textSize="16sp"
                    android:padding="10dp"
                    android:background="#F8FAFC" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email: sinhvien@example.com"
                    android:textColor="#334155"
                    android:textSize="15sp"
                    android:padding="10dp"
                    android:layout_marginTop="8dp"
                    android:background="#F8FAFC" />

                <TextView
                    android:id="@+id/tvGpa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GPA: 3.20 / 4.00"
                    android:textColor="#1D4ED8"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="14dp"
                    android:layout_marginTop="12dp"
                    android:background="#DBEAFE" />

                <TextView
                    android:id="@+id/tvXepLoai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Xep loai: Gioi"
                    android:textColor="#166534"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginTop="10dp"
                    android:background="#DCFCE7" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CardView cap nhat GPA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CAP NHAT DIEM GPA"
                    android:textColor="#1D4ED8"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nhap diem tu 0.0 den 4.0"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/edtGpaInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Vi du: 3.50"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLines="1"
                    android:padding="14dp"
                    android:minHeight="52dp"
                    android:backgroundTint="#2563EB"
                    android:importantForAutofill="no" />

                <Button
                    android:id="@+id/btnUpdateGpa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cap Nhat Diem GPA"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:layout_marginTop="16dp"
                    android:minHeight="52dp" />

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Khoi Phuc Mac Dinh"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp"
                    android:minHeight="52dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ung dung quan ly ho so hoc tap sinh vien"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
